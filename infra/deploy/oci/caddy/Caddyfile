# ATLAS edge: HTTPS with automatic Let's Encrypt certificates for every hostname.
#
#   {$ATLAS_WEB_HOST}    the web app (static build) and the ATLAS API under /api
#   {$ATLAS_VOICE_HOST}  only the voice service's call signalling WebSocket
#   {$ATLAS_AI_HOST}     optional: the AI gateway for other ATLAS installations
#                        (ai-gateway.caddy, imported at the end)
#
# The names come from .env through docker-compose.prod.yml. No access log: signalling
# URLs carry one-time session tokens. A models-only host uses models.Caddyfile instead.
import common.caddy

(proxy_options) {
	# Stream server-sent events (typed test chat, live transcript) as they are written, and
	# keep WebSockets (calls) open for up to 5 minutes across a configuration reload.
	flush_interval -1
	stream_close_delay 5m
	transport http {
		dial_timeout 5s
	}
}

{$ATLAS_WEB_HOST} {
	import security_headers

	handle /api/* {
		reverse_proxy api:8080 {
			import proxy_options
		}
	}

	handle {
		root * /srv/web
		encode zstd gzip
		header {
			X-Frame-Options "DENY"
			Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
			# Same-origin scripts only (the theme script is a file, not inline). Inline styles are
			# allowed: the grid and dialogs position elements with style attributes. Calls connect
			# to the signalling host; voice previews of hosted providers are https audio.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob: data: https:; connect-src 'self' wss://{$ATLAS_VOICE_HOST}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		# Hashed bundles never change; everything else (index.html) is revalidated.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@mutable not path /assets/*
		header @mutable Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$ATLAS_VOICE_HOST} {
	import security_headers

	# Browsers (test calls, the website widget) only open the signalling WebSocket here:
	# ATLAS hands out the one-time session and the TURN credentials itself. The voice
	# service's own API (accounts, agents, embed tokens, admin routes) is never exposed.
	@signalling path /api/v1/ws/public/signaling/*
	handle @signalling {
		reverse_proxy voice-runtime:8000 {
			import proxy_options
		}
	}

	handle {
		respond 404
	}
}

# The AI gateway on its own hostname, when deploy.sh runs with --ai-host:
# docker-compose.ai-gateway.yml sets ATLAS_AI_GATEWAY_SITE=ai-gateway.caddy. Without it the
# import is an empty file and nothing above changes.
import {$ATLAS_AI_GATEWAY_SITE:ai-gateway-off.caddy}
