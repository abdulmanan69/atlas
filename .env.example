# Copy to .env and fill in. Never commit .env. Placeholders only.

ATLAS_ENVIRONMENT=local
ATLAS_PRODUCT_NAME=ATLAS
ATLAS_LOG_LEVEL=INFO

# Host-run API connects to the compose services on these ports.
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@127.0.0.1:5433/atlas
ATLAS_REDIS_URL=redis://127.0.0.1:6380/0
ATLAS_POSTGRES_PASSWORD=atlas

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ATLAS_JWT_SECRET=replace-with-a-long-random-secret
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATLAS_SECRETS_ENCRYPTION_KEY=

ATLAS_COOKIE_SECURE=false
ATLAS_CORS_ORIGINS=http://localhost:5173
ATLAS_ALLOW_SIGNUP=true
ATLAS_DOCS_ENABLED=true

# Safety switch. While false, campaigns run in dry-run/simulation only and no real call is placed.
ATLAS_LIVE_CALLS_ENABLED=false

# Voice runtime (internal). Tenant accounts and keys are provisioned automatically.
ATLAS_VOICE_RUNTIME_BASE_URL=http://127.0.0.1:8000
ATLAS_VOICE_RUNTIME_PUBLIC_URL=http://localhost:8000
ATLAS_VOICE_RUNTIME_CALLBACK_URL=http://host.docker.internal:8080
ATLAS_WEB_APP_ORIGIN=http://localhost:5173
# Base URL visitors' browsers use for this API (website widget script and sessions).
# Empty: ATLAS_WEB_APP_ORIGIN, which proxies /api. See docs/website-widget.md.
ATLAS_PUBLIC_API_URL=
# Keep the runtime vendor's hosted trial models (sends call data to a third party).
ATLAS_VOICE_ALLOW_HOSTED_TRIAL_MODELS=false
# Knowledge documents (agents answer from uploaded files). Document parsing uses an
# external processing service; switch off for deployments that must not send documents out.
ATLAS_KNOWLEDGE_ENABLED=true
ATLAS_KNOWLEDGE_MAX_UPLOAD_BYTES=5242880

# Outbound destination policy for customer-configured URLs (actions, webhooks).
# Private/loopback addresses are blocked unless explicitly allowed (development only).
ATLAS_ALLOW_PRIVATE_ACTION_URLS=false
ATLAS_ALLOW_PRIVATE_WEBHOOK_URLS=false

# Self-hosted language model warm-up (docs/local-models.md, "Warming the prompt"): ATLAS
# sends the agent's prompt to the model server while a call connects. The connection's
# base URL (http://local-llm:11434/v1) only resolves inside Docker, so an API running on
# the host reaches the model server through its published port instead. Outside local
# development this URL must use https (destination policy), unless its host is internal:
# an API container uses http://local-llm:11434/v1 (see infra/deploy/oci/).
ATLAS_LOCAL_LLM_WARMUP_ENABLED=true
ATLAS_LOCAL_LLM_WARMUP_URL=http://127.0.0.1:11434/v1
# Warm a tenant connection's own base URL when it is a private address (own network only).
ATLAS_ALLOW_PRIVATE_MODEL_URLS=false

# Pocket TTS voice cloning (docs/local-models.md, "Voice cloning"). Where ATLAS itself
# reaches the Pocket TTS server to list, clone and delete voices: the connection's base URL
# (http://local-tts:8000/v1) only resolves inside Docker, so an API running on the host uses
# the published port. Unset = the connection's own base URL (must then be a public address
# unless ATLAS_ALLOW_PRIVATE_MODEL_URLS=true). Outside local development it must use https
# unless its host is internal (an API container uses http://local-tts:8000/v1).
ATLAS_LOCAL_TTS_URL=http://127.0.0.1:8002/v1
# Only when the Pocket TTS server requires a key (POCKET_TTS_API_KEY).
ATLAS_LOCAL_TTS_API_KEY=
# The same for the expressive voice server (Chatterbox-Turbo; connections named
# "expressive" or "chatterbox"), where ATLAS also reads the sounds it can make. Unset = the
# connection's own base URL, under the same rules. An API container uses
# http://expressive-tts:8000/v1.
# ATLAS_EXPRESSIVE_TTS_URL=
# ATLAS_EXPRESSIVE_TTS_API_KEY=
# Who may turn voice cloning on or off (a setting of the voice server, shared by every
# organization using it): owners (default) or operator (shared hosting; only the server's
# POCKET_TTS_HF_TOKEN). docs/local-models.md, "Voice cloning".
ATLAS_VOICE_CLONING_SWITCH=owners
# Read by docker compose, not by the API: Hugging Face token of an account that accepted the
# terms of the gated kyutai/pocket-tts weights, passed to local-tts as HF_TOKEN. Empty = no
# voice cloning (built-in voices still work). Restart local-tts after changing it.
POCKET_TTS_HF_TOKEN=

# Tenant API keys and outbound webhooks
ATLAS_RATE_LIMIT_API_KEY_PER_MINUTE=600
ATLAS_WEBHOOK_TIMEOUT_SECONDS=10
ATLAS_WEBHOOK_MAX_ATTEMPTS=8
ATLAS_WEBHOOK_AUTO_DISABLE_AFTER_FAILURES=50

# Required by `make voice-up`. Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ATLAS_VOICE_RUNTIME_JWT_SECRET=
# Optional: enables the platform-wide pipeline health panel (owner/admin). Same value is
# passed to the voice service as its metrics secret. Generate like the secrets above.
ATLAS_VOICE_RUNTIME_METRICS_SECRET=
ATLAS_VOICE_STORAGE_PASSWORD=
